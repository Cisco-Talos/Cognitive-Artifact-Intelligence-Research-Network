# Copy to .env or export these in your shell.
# Do not commit real API keys.
VIRUSTOTAL_API_KEY=

# Local research corpus. SQLite is the default because CAIRN is a tuning lab.
CAIRN_DATABASE_PATH=./data/cairn.sqlite

# Conservative defaults. Increase only after you confirm VT entitlement/rate limits.
CAIRN_RATE_LIMIT_PER_MINUTE=4
CAIRN_DAILY_LIMIT=500

# Optional: PromptIntel IOC feed (cairn sync-promptintel). Leave blank if unused.
PROMPTINTEL_API_KEY=

